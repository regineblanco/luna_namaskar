var userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
var sameTZ = partsIn(userTZ, new Date()).hour === partsIn(STUDIO_TZ, new Date()).hour;
if (!sameTZ) document.getElementById("tz-note").textContent = ", with your local time under each class";

document.querySelectorAll("[data-book]").forEach(function (el) {
  var slug = el.getAttribute("data-book");
  var link = CAL_USERNAME + "/" + slug;
  var config = {};
  el.href = "https://cal.com/" + link;

  if (el.hasAttribute("data-day")) {
    var n = nextClass(+el.getAttribute("data-day"), el.getAttribute("data-time"));
    var u = partsIn(userTZ, n.instant);   // cal.com shows slots in the visitor's timezone
    config.date = u.year + "-" + u.month + "-" + u.day;
    config.month = config.date.slice(0, 7);
    if (!sameTZ) {
      el.querySelector(".local").textContent = "your time: " + n.instant.toLocaleString([], {
        weekday: "short", hour: "2-digit", minute: "2-digit" });
    }
    el.href += "?date=" + config.date + "&month=" + config.month;
  }

  el.addEventListener("click", function (e) {
    if (!embedReady) return;            // embed didn't load: fall back to cal.com in a new tab
    e.preventDefault();
    Cal("modal", { calLink: link, config: config });
  });
});
</script>
</body>
</html>
