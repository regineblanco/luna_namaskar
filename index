<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>luna namaskar · yoga with regine blanco</title>
<style>
:root{
  --paper:#f7f4ed;
  --ink:#23251f;
  --muted:#77766f;
  --line:#d8d2c8;
  --stone:#e8e2d8;
  --rose:#e6c5c7;
  --sage:#dfe1d7;
  --sand:#e9dfce;
  --white:#fcfbf7;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
.page{width:min(1260px,100%);margin:auto;padding:0 28px 72px}

header{
  min-height:108px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:28px;
}
.brand{line-height:.84;min-width:220px}
.brand-name{
  font:700 27px/.82 Georgia,serif;
  letter-spacing:-1.3px;
}
.brand-sub{
  font:400 11px Georgia,serif;
  margin-top:10px;
}
nav{
  display:flex;
  gap:28px;
  font-size:10px;
  letter-spacing:1.2px;
  color:#5d5e57;
}
.btn{
  border:1px solid var(--ink);
  background:var(--ink);
  color:#fff;
  border-radius:999px;
  padding:13px 21px;
  font-size:12px;
  white-space:nowrap;
}
.btn.light{background:transparent;color:var(--ink)}
.btn.rose{background:var(--rose);border-color:var(--rose);color:var(--ink)}

.eyebrow{
  font-size:10px;
  letter-spacing:2px;
  color:#707169;
}
h1{
  font:400 clamp(68px,8.2vw,108px)/.81 Georgia,serif;
  letter-spacing:-5px;
  margin:18px 0 27px;
}
h2{
  font:400 clamp(42px,4.2vw,58px)/.98 Georgia,serif;
  letter-spacing:-2.5px;
  margin:0;
}
p{margin:0}

.hero{
  position:relative;
  overflow:hidden;
  min-height:500px;
  border-radius:27px;
  background:
    radial-gradient(ellipse 68% 78% at 78% 48%,rgba(239,211,216,.74) 0%,rgba(239,211,216,.36) 40%,rgba(239,211,216,0) 73%),
    linear-gradient(115deg,#e8e2d8 0%,#ece5dd 50%,#f0dadd 100%);
  display:flex;
  align-items:center;
}
.hero-copy{
  width:100%;
  padding:78px 8% 82px;
  max-width:920px;
}
.hero-copy p{
  max-width:590px;
  font-size:17px;
  line-height:1.58;
  color:#5e6059;
}
.actions{
  display:flex;
  gap:10px;
  margin-top:30px;
  flex-wrap:wrap;
}

.section{padding-top:88px}
.section-head,.practice-intro{
  display:grid;
  grid-template-columns:1fr auto;
  gap:35px;
  align-items:end;
  margin-bottom:26px;
}
.note{
  font-size:12px;
  line-height:1.55;
  color:var(--muted);
  max-width:400px;
}

.calendar-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.calendar{
  display:grid;
  grid-template-columns:repeat(5,minmax(185px,1fr));
  min-width:925px;
  border-top:1px solid var(--line);
  border-left:1px solid var(--line);
}
.day{
  min-height:350px;
  border-right:1px solid var(--line);
  padding:15px 11px;
}
.day:first-child{background:var(--rose)}
.day-title{
  font-size:10px;
  letter-spacing:1.5px;
  color:var(--muted);
  padding-bottom:14px;
  border-bottom:1px solid var(--line);
}
.class{
  background:var(--white);
  border:1px solid var(--line);
  border-radius:15px;
  padding:15px;
  margin-top:12px;
  min-height:112px;
}
.class time{font-size:10px;color:var(--muted)}
.class h3{
  font:400 21px/1 Georgia,serif;
  margin:10px 0 0;
  letter-spacing:-.4px;
}

.private{
  margin-top:88px;
  background:var(--rose);
  border-radius:27px;
  padding:54px 56px;
  display:grid;
  grid-template-columns:1fr auto;
  gap:45px;
  align-items:end;
}
.private h2{max-width:690px}
.private p{
  font-size:15px;
  line-height:1.65;
  color:#5d5f58;
  max-width:690px;
  margin-top:17px;
}
.private .actions{margin-top:24px}

.teacher{
  display:grid;
  grid-template-columns:minmax(280px,.82fr) minmax(0,1.18fr);
  gap:clamp(40px,7vw,92px);
  align-items:start;
}
.bio-photo{
  position:relative;
  overflow:hidden;
  border-radius:25px;
  aspect-ratio:1024/1536;
  background:#c7b5aa;
}
.bio-photo img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
.bio-photo:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(0deg,rgba(25,27,23,.12),transparent 42%);
}
.teacher-copy{max-width:720px}
.teacher-copy p{
  font-size:15px;
  line-height:1.68;
  color:#5e6059;
  margin-top:18px;
}

.styles{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
}
.style{
  min-height:265px;
  border:1px solid var(--line);
  border-radius:20px;
  padding:22px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  background:var(--white);
}
.style:nth-child(2){background:var(--rose)}
.style:nth-child(3){background:var(--sage)}
.style:nth-child(4){background:#e5d4d2}
.style:nth-child(5){background:var(--sand)}
.style h3{
  font:400 27px/1 Georgia,serif;
  letter-spacing:-1px;
  margin:0;
}
.style p{
  font-size:12px;
  line-height:1.52;
  color:#62635d;
  margin:0;
}

.start{
  margin-top:88px;
  background:var(--ink);
  color:white;
  border-radius:27px;
  padding:52px 56px;
  display:grid;
  grid-template-columns:1fr auto;
  gap:50px;
  align-items:end;
}
.start h2{color:white;max-width:760px}
.start p{
  font-size:13px;
  line-height:1.55;
  color:#c4c6bf;
  max-width:610px;
  margin-top:17px;
}
.start .small{font-size:11px;color:#aeb1aa;margin-top:8px}
.start-actions{display:flex;flex-direction:column;gap:9px}
.start .btn.light{border-color:#777b74;color:white}

@media(max-width:900px){
  .page{padding-left:20px;padding-right:20px}
  header{min-height:92px}
  nav{display:none}
  .hero{min-height:0}
  .hero-copy{padding:64px 42px 68px}
  .teacher{grid-template-columns:1fr;gap:34px}
  .bio-photo{max-height:650px}
  .styles{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:620px){
  .page{padding:0 16px 48px}
  header{
    min-height:88px;
    gap:12px;
  }
  .brand{min-width:0}
  .brand-name{font-size:23px;letter-spacing:-1px}
  .brand-sub{font-size:10px;margin-top:8px}
  header>.btn{padding:11px 16px;font-size:11px}

  .hero{
    border-radius:22px;
    background:
      radial-gradient(ellipse 95% 62% at 82% 25%,rgba(239,211,216,.72) 0%,rgba(239,211,216,0) 70%),
      linear-gradient(180deg,#e8e2d8 0%,#f0dadd 100%);
  }
  .hero-copy{padding:48px 26px 54px}
  h1{
    font-size:clamp(54px,16vw,76px);
    line-height:.83;
    letter-spacing:-3.8px;
    margin:15px 0 24px;
  }
  .hero-copy p{font-size:15px;line-height:1.55}
  .actions{margin-top:24px}
  .btn{padding:12px 17px;font-size:11px}

  .section{padding-top:62px}
  .section-head,.practice-intro{
    display:block;
    margin-bottom:22px;
  }
  .section-head h2,.practice-intro h2{margin-bottom:13px}
  .note{max-width:none;font-size:11px;line-height:1.5}

  .calendar{min-width:calc(100vw - 32px)}
  .day{
    min-height:330px;
    padding:13px 10px;
  }
  .class{padding:13px;min-height:105px}
  .class h3{font-size:19px}

  .private{
    margin-top:62px;
    border-radius:22px;
    padding:34px 26px;
    display:block;
  }
  .private p{font-size:14px;line-height:1.58;margin-top:15px}
  .private .actions{margin-top:23px}

  .teacher{gap:28px}
  .bio-photo{
    aspect-ratio:1024/1536;
    max-height:none;
    border-radius:22px;
  }
  .teacher-copy p{font-size:14px;line-height:1.62;margin-top:16px}

  .styles{
    grid-template-columns:1fr;
    gap:10px;
  }
  .style{
    min-height:205px;
    border-radius:18px;
    padding:20px;
  }
  .style h3{font-size:25px}
  .style p{font-size:12px;line-height:1.52}

  .start{
    margin-top:62px;
    border-radius:22px;
    padding:34px 26px;
    display:block;
  }
  .start h2{font-size:40px;line-height:.98;letter-spacing:-1.8px}
  .start p{font-size:13px}
  .start-actions{margin-top:26px}
  .start-actions .btn{width:100%}
}
</style>
